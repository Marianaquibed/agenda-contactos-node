<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Añadir Nuevo Contacto</title>
  <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
  <h1>Añadir Nuevo Contacto</h1>

  <form action="/contacts/new" method="POST" style="max-width: 400px;">
    <div>
      <label for="nombre">Nombre:</label><br>
      <input type="text" id="nombre" name="nombre" required style="width: 100%; margin-bottom: 10px;">
    </div>
    <div>
      <label for="telefono">Teléfono:</label><br>
      <input type="text" id="telefono" name="telefono" required style="width: 100%; margin-bottom: 10px;">
    </div>
    <div>
      <label for="email">E-mail:</label><br>
      <input type="email" id="email" name="email" required style="width: 100%; margin-bottom: 10px;">
    </div>
    <div>
      <label for="provincia_id">Provincia:</label><br>
      <select id="provincia_id" name="provincia_id" required style="width: 100%; margin-bottom: 15px; padding: 8px;">
        <option value="">-- Selecciona una provincia --</option>
        <% provincias.forEach(p => { %>
          <option value="<%= p.id %>"><%= p.nombre %></option>
        <% }) %>
      </select>
    </div>

    <button type="submit" class="btn">Guardar Contacto</button>
    <a href="/contacts" class="btn" style="background-color: gray;">Cancelar</a>
  </form>
</body>
</html>
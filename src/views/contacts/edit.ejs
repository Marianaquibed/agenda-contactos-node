<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar Contacto</title>
  <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
  <h1>Editar Contacto</h1>

  <form action="/contacts/edit/<%= contact.id %>" method="POST" style="max-width: 400px;">
    <div>
      <label for="nombre">Nombre:</label><br>
      <input type="text" id="nombre" name="nombre" value="<%= contact.nombre %>" required style="width: 100%; margin-bottom: 10px;">
    </div>
    <div>
      <label for="telefono">Teléfono:</label><br>
      <input type="text" id="telefono" name="telefono" value="<%= contact.telefono %>" required style="width: 100%; margin-bottom: 10px;">
    </div>
    <div>
      <label for="email">E-mail:</label><br>
      <input type="email" id="email" name="email" value="<%= contact.email %>" required style="width: 100%; margin-bottom: 10px;">
    </div>
    <div>
      <label for="provincia_id">Provincia:</label><br>
      <select id="provincia_id" name="provincia_id" required style="width: 100%; margin-bottom: 15px; padding: 8px;">
        <% provincias.forEach(p => { %>
          <option value="<%= p.id %>" <%= p.id === contact.provincia_id ? 'selected' : '' %>>
            <%= p.nombre %>
          </option>
        <% }) %>
      </select>
    </div>

    <button type="submit" class="btn">Actualizar Contacto</button>
    <a href="/contacts" class="btn" style="background-color: gray;">Cancelar</a>
  </form>
</body>
</html>
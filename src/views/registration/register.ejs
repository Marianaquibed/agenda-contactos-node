<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Registro de Usuario</title>
  <link rel="stylesheet" href="/css/estilos.css">
</head>
<body>
  <h1>Crear Cuenta</h1>

  <% if (error) { %>
    <p style="color: red;"><%= error %></p>
  <% } %>

  <form action="/register" method="POST" style="max-width: 350px;">
    <div>
      <label for="email">E-mail:</label><br>
      <input type="email" id="email" name="email" required style="width: 100%; margin-bottom: 10px;">
    </div>
    <div>
      <label for="password">Contraseña:</label><br>
      <input type="password" id="password" name="password" required style="width: 100%; margin-bottom: 15px;">
    </div>
    <button type="submit" class="btn">Registrarse</button>
    <a href="/security/login" class="btn" style="background-color: gray;">Ir a Login</a>
  </form>
</body>
</html>